-- allium: 3
--
-- Casiopea-Con§tel (slug: casiopea-constel) — especificación de comportamiento.
--
-- Aplicación a MediaWiki 1.43 de con§tel (github.com/hspencer/constel):
-- lectura activa y análisis temático (Braun & Clarke) sobre las páginas de
-- Casiopea, ahora con MUCHOS lectores. La hipótesis de origen (e[ad] PUCV,
-- 2004–2006) se mantiene: la interacción produce un espacio semántico —
-- aquí, un espacio semántico COLECTIVO.
--
-- MODELO (fiel a constel, decisión 2026-09-22):
--
--   página wiki (source) ──1:N──▸ § excerpt   (pasaje de un lector)
--   excerpt ◂──N:M──▸ concept                   (vía Coding)
--   concept ──N:1──▸ theme    POR LECTOR        (vía ThemeMembership)
--   theme   ──1:0..1──▸ development          (su desarrollo: un texto)
--
-- Diferencias con el constel standalone, todas por pasar a multiusuario:
--   · Un excerpt pertenece a su autor; sólo él lo codifica.
--   · Los conceptos son GLOBALES: vocabulario compartido, un rótulo
--     normalizado = una estrella. Renombrar/fusionar es de moderación.
--   · Los temas son PERSONALES (cada lector sintetiza a su modo, y el
--     mismo concepto puede caer en temas distintos para lectores
--     distintos) pero VISIBLES para todos; sólo su dueño los edita.
--   · Las páginas cambian. El ancla se re-ubica tras cada revisión; si
--     no se puede, el excerpt queda PERDIDO (desanclado): deja de verse
--     sobre el texto, pero conserva sus conceptos y sigue en el mapa. Si
--     la página se BORRA, sus §§ quedan CONGELADOS: en reserva, sólo
--     borrables, y se re-anclan si la página se restaura.
--   · El mapa une conceptos por co-excerpt (mismo §) Y por solapamiento
--     de §§ de lectores distintos sobre el mismo pasaje.
--
-- ALCANCE. Allium describe comportamiento observable. NO modela (va a
-- docs/ y al código): esquema SQL, Action API, módulos ResourceLoader,
-- clases PHP; la presentación del popup, resaltado y grafo (2D/3D,
-- fuerzas, colores de tema, tipografía); el algoritmo de anclaje, de
-- fuzzy match y de ortografía canónica (cajas negras).
--
-- FUERA DE ALCANCE, también en la versión final (decisión 2026-09-22):
-- la glosa cronológica del Lector de constel y las colecciones de corpus
-- (p. ej. filtrar el mapa por "Amereida"). El minimap de §§ en la página
-- sí entró (2026-09-25, pedido del usuario); es presentación del
-- resaltado, así que vive en el código (minimap.js), no aquí. Incorpora al
-- instante los §§ nuevos o que ganan conceptos, con una entrada animada
-- (2026-09-26).

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- Gobernadas por MediaWiki, no por este spec.

external entity User {
    identity: UserIdentity
    is_blocked: Boolean             -- bloqueo sitewide
    blocked_pages: Set<WikiPage>    -- bloqueos parciales (por página)
    rights: Set<String>             -- derechos efectivos ($wgGroupPermissions)
    constel_enabled: Boolean        -- preferencia del lector; DESACTIVADA por defecto (ver PageReading)
}

-- Identidad = page_id de MediaWiki: sobrevive a traslados (renombrar la
-- página no pierde excerpts).
--
-- is_annotatable = existe, está en un namespace de contenido
-- ($wgContentNamespaces), no es redirección y tiene revisión. Todas las
-- páginas de contenido son anotables (decisión 2026-09-22), sin opt-in, y
-- también las PROTEGIDAS (decisión 2026-09-23): anotar no es editar.
--
-- Una página borrada conserva su identidad (page_id): la restauración de
-- MediaWiki la devuelve con el mismo id, o funde su historial en la página
-- que se haya recreado con ese título (sus §§ pasan a ésa).
external entity WikiPage {
    is_annotatable: Boolean
    latest_revision: Revision?
}

external entity Revision {
    page: WikiPage
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- Buena ciudadanía como extensión MediaWiki 1.43. Direccionalidad: la
-- extensión las CUMPLE. Realización en docs/ARCHITECTURE.md.
contract MediaWikiExtensionConformance {
    register: (page: WikiPage, viewer: User) -> Boolean

    @invariant DeclarativeManifest
        -- Todo el registro (hooks, API, páginas especiales, módulos RL,
        -- derechos, mensajes, config, autoload PSR-4, esquema) vive en
        -- extension.json (manifest_version 2). En LocalSettings sólo
        -- wfLoadExtension y overrides de config.

    @invariant WritesAreTokenProtected
        -- Toda operación mutante viaja por la Action API como POST con
        -- token CSRF y re-comprueba identidad, derechos y bloqueos en el
        -- servidor. El cliente nunca es la autoridad.

    @invariant RightsDeclared
        -- Los permisos son derechos MediaWiki declarados
        -- (config.annotate_right, config.moderate_right), asignables por
        -- grupo; nunca comprobaciones de grupo cableadas.

    @invariant RightToWithdraw
        -- Crear y editar la lectura propia (§§, codificaciones, glosas,
        -- temas, desarrollos) requiere config.annotate_right; BORRARLA no:
        -- basta ser su dueño y no estar bloqueado. Quien pierde el derecho
        -- —p. ej. un grupo al que se le cierra con§tel— no queda atrapado
        -- con una lectura pública y firmada que no puede quitar (decisión
        -- 2026-09-23). Un moderador borra §§ ajenos con config.moderate_right,
        -- sin necesitar además el de anotar.

    @invariant AnnotatingIsNotEditing
        -- Anotar una página se autoriza con config.annotate_right sobre ESA
        -- página: cuentan los bloqueos (sitewide y parciales), no la
        -- protección de página ni la protección en cascada, que restringen
        -- editar el wikitexto (decisión 2026-09-23). La preferencia
        -- constel_enabled es sólo de presentación: no autoriza nada.

    @invariant FullyLocalised
        -- Todo texto de interfaz es mensaje i18n (es + en + qqq). El
        -- signo "§" es contenido; su nombre accesible es mensaje.

    @invariant SkinAgnostic
        -- Funciona igual en Stella Nova, Vector 2022 y MinervaNeue: se
        -- ancla sólo a puntos canónicos del core (#mw-content-text,
        -- .mw-parser-output), nunca a markup de un skin. El skin puede
        -- ABSORBER sus estilos (ResourceModuleSkinStyles), no al revés.

    @invariant DesignedOnStellaNovaTokens
        -- La GUI es plenamente compatible con Stella Nova y usa sus
        -- tokens (decisión 2026-09-22): consume sólo tokens SEMÁNTICOS y
        -- de COMPONENTE --sn-* (nunca primitivas), vía una única capa de
        -- alias --constel-* con respaldo Codex/literal para otros skins.
        -- Hereda el flip claro/oscuro y la tipografía del skin; ningún
        -- componente trae colores, fuentes ni medidas propias.

    @invariant ContentUntouched
        -- Anotar no modifica el wikitexto, no crea revisiones ni
        -- invalida la ParserCache: los §§ se pintan en el cliente sobre
        -- el DOM ya renderizado.

    @invariant OutputEscaped
        -- Rótulos de concepto y tema, pasajes y notas son texto plano
        -- del usuario: se escapan siempre (nunca wikitexto ni HTML).

    @invariant ReadingIsPublicData
        -- Excerpts, codificaciones, temas y notas son públicos dentro de
        -- la wiki (decisión 2026-09-22), salvo los §§ congelados
        -- (FrozenIsPrivate). La interfaz lo advierte al anotar por primera
        -- vez. Se atribuyen al nombre de usuario; respetan la supresión de
        -- nombres (hideuser) del core.

    @invariant FrozenIsPrivate
        -- Un § congelado cita una página borrada. Su pasaje y su glosa sólo
        -- los ven su autor y quienes pueden ver texto borrado (derecho
        -- deletedtext del core), y mientras dure el congelamiento no cuenta
        -- para nadie en el mapa: ni frecuencia ni aristas; un concepto que
        -- sólo vive en §§ congelados sale del mapa (sin borrarse) y vuelve
        -- si la página se restaura (decisión 2026-09-23).
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- MediaWiki 1.43: anónimo-IP, cuenta temporal (IP-masking) o registrado.
enum UserIdentity { anonymous | temporary | registered }


------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- Ancla textual estilo W3C Web Annotation: TextQuoteSelector (exact +
-- prefix + suffix) + TextPositionSelector (start/end). Se mide sobre el
-- TEXTO PLANO RENDERIZADO del cuerpo de la revisión, no sobre el
-- wikitexto (en constel: offsets sobre el .txt).
value TextAnchor {
    exact: String
    prefix: String                  -- config.anchor_context_length caracteres
    suffix: String
    start: Integer
    end: Integer
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

-- Vocabulario GLOBAL. Identidad ESTRICTA, con la semántica de un título
-- de MediaWiki (decisión 2026-09-22): "Diseño" ≠ "Diseno". Ver
-- normalize_concept. El rótulo ES la identidad: se guarda ya en forma
-- canónica («diseño  gráfico» se ve «Diseño gráfico»), no hay un rótulo
-- visible aparte de la clave (decisión 2026-09-23).
entity Concept {
    label: String                   -- normalize_concept(lo escrito al crearlo o renombrarlo)

    codings: Coding with concept = this
    memberships: ThemeMembership with concept = this

    excerpts: codings.excerpt
    pages: excerpts.page
    readers: excerpts.author
    is_unused: codings.count = 0
}

-- § — un pasaje seleccionado por un lector en una página.
entity Excerpt {
    author: User
    page: WikiPage
    anchor: TextAnchor
    revision: Revision              -- última revisión donde el ancla es válida
    gloss: String?                  -- glosa: comentario o aclaración del lector sobre el pasaje
    created_at: Timestamp

    codings: Coding with excerpt = this
    concepts: codings.concept

    -- lost: una edición dejó el pasaje sin ubicación (definitivo mientras
    --   la página exista). frozen: la página se borró; sólo se puede borrar
    --   el §, y restaurar la página intenta re-anclarlo.
    anchor_status: anchored | lost | frozen
    lost_at: Timestamp when anchor_status = lost
    frozen_at: Timestamp when anchor_status = frozen

    transitions anchor_status {
        anchored -> lost
        anchored -> frozen
        lost -> frozen
        frozen -> anchored
        frozen -> lost
    }

    is_drawn_on_page: anchor_status = anchored
    is_frozen: anchor_status = frozen
    is_uncoded: codings.count = 0
}

-- La codificación: el acto de asignar un concepto a un §.
entity Coding {
    excerpt: Excerpt
    concept: Concept
    coded_at: Timestamp
}

-- Tema: metacategoría PERSONAL de su dueño, visible para todos.
entity Theme {
    owner: User
    label: String
    created_at: Timestamp

    memberships: ThemeMembership with theme = this
    development: ThemeDevelopment with theme = this   -- a lo sumo uno

    concepts: memberships.concept
}

-- Pertenencia concepto→tema, POR LECTOR (constel: concept.themeId).
entity ThemeMembership {
    theme: Theme
    concept: Concept

    owner: theme.owner
}

-- Desarrollo del tema: la destilación, el texto propio del lector. UNO por
-- tema (decisión 2026-09-22: un tema no acumula notas, se desarrolla). En el
-- export a constel viaja como la única «note» del tema.
entity ThemeDevelopment {
    theme: Theme
    text: String
    updated_at: Timestamp

    author: theme.owner
}

-- Una exportación de la lectura de un usuario.
entity ReadingExport {
    owner: User
    requested_at: Timestamp
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    extension_version: String = "0.10.0"          -- debe coincidir con extension.json
    concept_max_length: Integer = 80             -- caracteres
    theme_label_max_length: Integer = 80
    note_max_length: Integer = 20000             -- desarrollo de un tema
    selection_min_length: Integer = 3            -- como constel (popup.js)
    selection_max_length: Integer = 2000
    gloss_max_length: Integer = 5000             -- caracteres de la glosa de un §
    anchor_context_length: Integer = 32          -- prefix/suffix
    annotate_right: String = "constel-annotate"  -- default: grupo user
    moderate_right: String = "constel-moderate"  -- default: grupo sysop (administradores)
}

------------------------------------------------------------
-- Rules — excerpts y codificación
------------------------------------------------------------

rule ReaderCreatesExcerpt {
    when: ReaderCreatesExcerpt(author, page, revision, anchor, concept_label, gloss, variant_confirmed)
    requires: author.identity = registered
    requires: config.annotate_right in author.rights
    requires: not author.is_blocked
    requires: page not in author.blocked_pages
    requires: page.is_annotatable
    requires: revision = page.latest_revision
    requires: length(trim(anchor.exact)) >= config.selection_min_length
    requires: length(anchor.exact) <= config.selection_max_length
    requires: anchor_resolves(anchor, revision)
    requires: not is_blank(concept_label)
    requires: length(normalize_concept(concept_label)) <= config.concept_max_length
    requires: gloss = null or length(gloss) <= config.gloss_max_length
    let existing = Concept{label: normalize_concept(concept_label)}
    requires: exists existing or variant_confirmed
        or not has_variants(normalize_concept(concept_label))
    ensures:
        let excerpt = Excerpt.created(
            author: author,
            page: page,
            anchor: anchor,
            revision: revision,
            gloss: if gloss = null or is_blank(gloss): null else: trim(gloss),
            created_at: now,
            anchor_status: anchored
        )
        let concept =
            if exists existing: existing
            else: Concept.created(label: normalize_concept(concept_label))
        Coding.created(excerpt: excerpt, concept: concept, coded_at: now)
    @guidance
        -- Como en constel, un § nace con su primer concepto: el popup no
        -- crea pasajes sin codificar. `revision = page.latest_revision`
        -- rechaza selecciones hechas sobre una vista vieja: el cliente
        -- envía el revid que muestra; si no es el último, error
        -- recuperable ("la página cambió; recarga") sin perder lo escrito.
        -- Los §§ del mismo autor pueden solaparse entre sí (constel los
        -- aplana al pintar; aquí sólo es presentación), pero no repetirse:
        -- si el autor ya tiene un § anclado sobre exactamente el mismo
        -- pasaje, el concepto se suma a ése (como ReaderCodesExcerpt) y la
        -- glosa sólo se toma si aquél no tenía (decisión 2026-09-23).
        -- Ortografía canónica (decisión 2026-09-22): la identidad es
        -- estricta como un título de MediaWiki, así que "Diseno" y "Diseño"
        -- serían conceptos distintos. La convergencia a la forma bien
        -- escrita NO la hace la identidad: la hace el popup al escribir
        -- (SelectionPopup.VariantsSteered) y, si una variante se cuela, un
        -- administrador la fusiona (ModeratorMergesConcepts).
}

rule ReaderCodesExcerpt {
    when: ReaderCodesExcerpt(actor, excerpt, concept_label, variant_confirmed)
    requires: actor = excerpt.author
    requires: not actor.is_blocked
    requires: config.annotate_right in actor.rights
    requires: excerpt.page not in actor.blocked_pages
    requires: not excerpt.is_frozen
    requires: not is_blank(concept_label)
    requires: length(normalize_concept(concept_label)) <= config.concept_max_length
    let existing = Concept{label: normalize_concept(concept_label)}
    requires: exists existing or variant_confirmed
        or not has_variants(normalize_concept(concept_label))
    requires: not (exists existing and existing in excerpt.concepts)
    ensures:
        let concept =
            if exists existing: existing
            else: Concept.created(label: normalize_concept(concept_label))
        Coding.created(excerpt: excerpt, concept: concept, coded_at: now)
    @guidance
        -- Aplica también a §§ perdidos: siguen siendo codificables (su
        -- pasaje citado se conserva), aunque no se dibujen. No a los
        -- congelados: su página se borró y sólo se pueden borrar.
}

-- La glosa: un comentario o aclaración propia sobre el pasaje, además de
-- sus conceptos (decisión 2026-09-22). Opcional; vacía = sin glosa.
rule ReaderGlossesExcerpt {
    when: ReaderGlossesExcerpt(actor, excerpt, gloss)
    requires: actor = excerpt.author
    requires: not actor.is_blocked
    requires: config.annotate_right in actor.rights
    requires: excerpt.page not in actor.blocked_pages
    requires: not excerpt.is_frozen
    requires: gloss = null or length(trim(gloss)) <= config.gloss_max_length
    ensures:
        if gloss = null or is_blank(gloss):
            excerpt.gloss = null
        else:
            excerpt.gloss = trim(gloss)
    @guidance
        -- Aplica también a §§ perdidos. Como el resto de la lectura, la
        -- glosa es pública (ReadingIsPublicData). Se guarda sin espacios
        -- extremos; en blanco = sin glosa.
}

rule ReaderUncodesExcerpt {
    when: ReaderUncodesExcerpt(actor, coding)
    requires: actor = coding.excerpt.author
    requires: not actor.is_blocked
    requires: config.annotate_right in actor.rights
    requires: coding.excerpt.page not in actor.blocked_pages
    requires: not coding.excerpt.is_frozen
    ensures: not exists coding
}

-- Un § sin conceptos no existe (nace codificado; muere al perder el último).
rule UncodedExcerptVanishes {
    when: excerpt: Excerpt.is_uncoded
    ensures: not exists excerpt
}

rule ReaderDeletesExcerpt {
    when: ReaderDeletesExcerpt(actor, excerpt)
    requires: actor = excerpt.author or config.moderate_right in actor.rights
    requires: not actor.is_blocked
    requires: excerpt.is_frozen or excerpt.page not in actor.blocked_pages
    ensures:
        for c in excerpt.codings:
            not exists c
        not exists excerpt
    @guidance
        -- Si quien borra no es el autor (moderación), queda en
        -- Special:Log/constel con el autor y el pasaje citado. Es lo único
        -- que admite un § congelado; como su página ya no existe, ahí sólo
        -- cuenta el bloqueo sitewide.
}

------------------------------------------------------------
-- Rules — anclaje frente a cambios de la página
------------------------------------------------------------

-- Nueva revisión guardada (edición, revert).
rule PageRevisedReanchorsExcerpts {
    when: PageRevised(page, revision)
    requires: revision = page.latest_revision
    for excerpt in page_excerpts(page) where anchor_status = anchored:
        ensures:
            if anchor_resolves(excerpt.anchor, revision):
                excerpt.anchor = relocate(excerpt.anchor, revision)
                excerpt.revision = revision
            else:
                excerpt.anchor_status = lost
                excerpt.lost_at = now
    @guidance
        -- Best effort, en un job diferido (JobQueue) tras
        -- PageSaveComplete, nunca en la request del guardado. Se busca
        -- `exact` con prefix/suffix en el texto renderizado de la nueva
        -- revisión; start/end sólo desempatan. Una ocurrencia única (o
        -- desempatada) traslada el ancla; ninguna o ambigua = perdido.
        -- Mientras el job no corre, el cliente puede ver §§ cuyo revid no
        -- es el actual: los intenta ubicar igual y omite los que fallen.
}

-- Borrar la página CONGELA sus §§, anclados y perdidos (decisión
-- 2026-09-23): no se borran —un borrado de MediaWiki es reversible— pero
-- quedan en reserva (FrozenIsPrivate) y sólo se pueden borrar.
rule PageDeletedFreezesExcerpts {
    when: PageDeleted(page)
    for excerpt in page_excerpts(page) where anchor_status != frozen:
        ensures:
            excerpt.anchor_status = frozen
            excerpt.frozen_at = now
}

-- Restaurar la página intenta re-anclar sus §§ congelados (decisión
-- 2026-09-23): los que ubican su pasaje vuelven a la página; los demás
-- quedan perdidos.
rule PageRestoredReanchorsExcerpts {
    when: PageRestored(page, revision)
    requires: revision = page.latest_revision
    for excerpt in page_excerpts(page) where anchor_status = frozen:
        ensures:
            if anchor_resolves(excerpt.anchor, revision):
                excerpt.anchor = relocate(excerpt.anchor, revision)
                excerpt.revision = revision
                excerpt.anchor_status = anchored
            else:
                excerpt.anchor_status = lost
                excerpt.lost_at = now
    @guidance
        -- Mismo job diferido que PageRevisedReanchorsExcerpts, tras
        -- PageUndeleteComplete. Si el título se había recreado, la
        -- restauración funde el historial en esa página: antes de re-anclar,
        -- sus §§ congelados pasan a ella.
}

------------------------------------------------------------
-- Rules — vocabulario compartido (moderación)
------------------------------------------------------------

rule ModeratorRenamesConcept {
    when: ModeratorRenamesConcept(actor, concept, new_label)
    requires: config.moderate_right in actor.rights
    requires: not actor.is_blocked
    requires: not is_blank(new_label)
    requires: length(normalize_concept(new_label)) <= config.concept_max_length
    requires: not exists Concept{label: normalize_concept(new_label)}
        or normalize_concept(new_label) = concept.label
    ensures:
        concept.label = normalize_concept(new_label)
    @guidance
        -- Si el rótulo nuevo ya existe como otro concepto, eso es una
        -- fusión (ModeratorMergesConcepts), no un renombre. Renombrar es
        -- la vía para corregir la ortografía de un concepto (p. ej.
        -- "Diseno" → "Diseño" cuando "Diseño" no existe). Renombres,
        -- fusiones y borrados de §§ ajenos quedan en Special:Log (tipo de
        -- registro propio de la extensión).
}

rule ModeratorMergesConcepts {
    when: ModeratorMergesConcepts(actor, keep, absorbed)
    requires: config.moderate_right in actor.rights
    requires: not actor.is_blocked
    requires: keep != absorbed
    ensures:
        for c in absorbed.codings:
            if keep in c.excerpt.concepts:
                not exists c
            else:
                c.concept = keep
        for m in absorbed.memberships:
            if exists ThemeMembership{concept: keep, owner: m.owner}:
                not exists m
            else:
                m.concept = keep
        not exists absorbed
    @guidance
        -- Como mergeConcepts de constel, deduplicando. En los temas de
        -- cada lector gana la pertenencia que ya tenía `keep`.
}

-- Un concepto que ningún § usa desaparece, y con él sus pertenencias.
rule UnusedConceptVanishes {
    when: concept: Concept.is_unused
    ensures:
        for m in concept.memberships:
            not exists m
        not exists concept
}

------------------------------------------------------------
-- Rules — temas y notas (personales)
------------------------------------------------------------

rule ReaderCreatesTheme {
    when: ReaderCreatesTheme(owner, label)
    requires: owner.identity = registered
    requires: config.annotate_right in owner.rights
    requires: not owner.is_blocked
    requires: not is_blank(label)
    requires: length(trim(label)) <= config.theme_label_max_length
    ensures: Theme.created(owner: owner, label: trim(label), created_at: now)
}

rule ReaderRenamesTheme {
    when: ReaderRenamesTheme(actor, theme, label)
    requires: actor = theme.owner
    requires: not actor.is_blocked
    requires: config.annotate_right in actor.rights
    requires: not is_blank(label)
    requires: length(trim(label)) <= config.theme_label_max_length
    ensures: theme.label = trim(label)
}

-- Borrar un tema desagrupa sus conceptos y borra sus notas (constel).
rule ReaderDeletesTheme {
    when: ReaderDeletesTheme(actor, theme)
    requires: actor = theme.owner
    requires: not actor.is_blocked
    ensures:
        for m in theme.memberships:
            not exists m
        if exists theme.development:
            not exists theme.development
        not exists theme
}

-- Agrupar: cualquier concepto del vocabulario, no sólo los propios — el
-- tema es la lente del lector sobre el mapa colectivo. Un concepto está
-- en a lo sumo un tema de cada lector: agrupar lo MUEVE.
rule ReaderGroupsConcept {
    when: ReaderGroupsConcept(actor, concept, theme)
    requires: actor = theme.owner
    requires: not actor.is_blocked
    requires: config.annotate_right in actor.rights
    let previous = ThemeMembership{concept: concept, owner: actor}
    ensures:
        if not (exists previous and previous.theme = theme):
            if exists previous:
                not exists previous
            ThemeMembership.created(theme: theme, concept: concept)
    @guidance
        -- Agrupar en el tema donde ya está no cambia nada y no es un error
        -- (decisión 2026-09-23): el gesto se puede repetir sin temor.
}

rule ReaderUngroupsConcept {
    when: ReaderUngroupsConcept(actor, membership)
    requires: actor = membership.owner
    requires: not actor.is_blocked
    requires: config.annotate_right in actor.rights
    ensures: not exists membership
}

-- Escribir el desarrollo lo crea o lo reemplaza; dejarlo en blanco lo borra.
rule ReaderWritesThemeDevelopment {
    when: ReaderWritesThemeDevelopment(actor, theme, text)
    requires: actor = theme.owner
    requires: not actor.is_blocked
    requires: config.annotate_right in actor.rights
    requires: length(trim(text)) <= config.note_max_length
    ensures:
        if is_blank(text):
            if exists theme.development:
                not exists theme.development
        else:
            if exists theme.development:
                theme.development.text = trim(text)
                theme.development.updated_at = now
            else:
                ThemeDevelopment.created(theme: theme, text: trim(text), updated_at: now)
}

------------------------------------------------------------
-- Rules — exportación a constel standalone
------------------------------------------------------------

rule ReaderExportsReading {
    when: ReaderExportsReading(owner)
    requires: owner.identity = registered
    ensures: ReadingExport.created(owner: owner, requested_at: now)
    @guidance
        -- Sólo exportación (decisión 2026-09-22; importar queda fuera).
        -- Produce un ZIP compatible con el Importar de constel v0.2.x:
        -- constel-db.json (version 1) + un .txt por página fuente con el
        -- texto plano renderizado de su revisión vigente. Los §§ perdidos
        -- y los congelados NO se exportan (decisión 2026-09-22): no tienen
        -- texto vigente donde ubicarse.
        -- Mapeo: página→source, §→excerpt (start/end del ancla; su glosa
        -- viaja en un campo propio, gloss, que constel conserva),
        -- temas propios→themes (concept.themeId desde su ThemeMembership),
        -- desarrollo→una note por tema. concepts = los de sus §§ exportados
        -- MÁS todos los de sus temas, aunque no los haya codificado él (o
        -- sólo en §§ que no se exportan): el tema es su lente sobre el
        -- vocabulario compartido y debe llegar completo (decisión
        -- 2026-09-23). De esos conceptos ajenos sólo viaja el rótulo.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant ReadersAreRegistered {
    for e in Excerpts:
        e.author.identity = registered
}

-- Un § anclado apunta siempre a la revisión vigente de su página.
-- Realización eventual: entre el guardado y la corrida del re-anclaje
-- diferido (ReanchorJob) un § puede apuntar a la revisión anterior; el
-- cliente lo ubica igual por la cita. Se cumple en cuanto corre el job.
invariant AnchoredMeansCurrent {
    for e in Excerpts where anchor_status = anchored:
        e.revision = e.page.latest_revision
}

invariant ExcerptsAreCoded {
    for e in Excerpts:
        e.codings.count >= 1
}

invariant NoDuplicateCoding {
    for e in Excerpts:
        e.codings.count = e.concepts.unique.count
}

invariant ConceptLabelsAreCanonical {
    for c in Concepts:
        c.label = normalize_concept(c.label)
}

-- constel: cada concepto pertenece a 1 tema o a ninguno — aquí, por lector.
invariant OneThemePerConceptPerReader {
    for m in ThemeMemberships:
        ThemeMemberships where concept = m.concept and owner = m.owner
            .count = 1
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- El popup "§" que aparece al seleccionar texto (popup.js de constel).
surface SelectionPopup {
    facing viewer: User
    context page: WikiPage where is_annotatable

    exposes:
        page.latest_revision

    provides:
        ReaderCreatesExcerpt(viewer, page, page.latest_revision, anchor, concept_label, gloss, variant_confirmed)
            when viewer.identity = registered
                and config.annotate_right in viewer.rights
                and not viewer.is_blocked
                and page not in viewer.blocked_pages
                and viewer.constel_enabled

    @guarantee AppearsOnSelection
        -- Al terminar una selección (ratón, táctil o teclado) de al menos
        -- config.selection_min_length caracteres, contenida por completo
        -- en el cuerpo de contenido, aparece junto a ella la afordancia
        -- "§". Activarla abre el campo de conceptos con el foco puesto y un
        -- segundo campo, opcional, para la glosa.

    @guarantee SeveralConceptsAtOnce
        -- El campo de conceptos admite varios (decisión 2026-09-26): una
        -- coma, o elegir una sugerencia, vuelve lo escrito una píldora
        -- dentro del mismo campo; × o Retroceso con el campo vacío la
        -- quitan. Lo escrito sin coma también cuenta al crear. El § nace
        -- con el primero (ReaderCreatesExcerpt) y los demás se le suman
        -- (ReaderCodesExcerpt), uno a uno: si uno pide elegir variante
        -- (VariantsSteered), los ya guardados salen del campo y se retoma
        -- desde ése. Lo mismo al agregar conceptos a un § propio
        -- (PageReading), donde no se ofrecen los que el § ya tiene.

    @guarantee PanelBesideText
        -- El panel (formulario del § y detalle) nace a la derecha del
        -- bloque del texto (párrafo, ítem, celda), sin taparlo, con su
        -- borde superior a la altura del inicio del § (decisión
        -- 2026-09-26). Si ahí no cabe ni angostado a su mínimo, va a la
        -- izquierda; si tampoco, bajo la selección. El lector puede
        -- moverlo y redimensionarlo; con más alto, la glosa crece con él.
        -- El tamaño elegido no se recuerda: cada panel nace igual.

    @guarantee SharedVocabularyAutocomplete
        -- El campo de concepto sugiere, con coincidencia difusa, el
        -- vocabulario COMPARTIDO (conceptos de todos los lectores),
        -- ordenado por uso. Elegir una sugerencia reutiliza el concepto;
        -- un rótulo nuevo lo crea.

    @guarantee VariantsSteered
        -- Si el rótulo escrito no existe pero hay conceptos que difieren
        -- de él sólo en tildes, diéresis, ñ/n, mayúsculas o espacios, el
        -- popup los ofrece ANTES de crear uno nuevo ("Diseno" → "¿Diseño?",
        -- para teclados sin ñ; decisión 2026-09-23). Crear la
        -- variante sigue siendo posible, pero requiere un gesto explícito:
        -- nunca se sustituye ni se une en silencio. La comparación
        -- tolerante sólo sugiere; la identidad sigue siendo estricta. El
        -- gesto es variant_confirmed, y no es sólo del popup: el servidor
        -- rechaza crear una variante sin él, venga de donde venga la
        -- llamada (ReaderCreatesExcerpt, ReaderCodesExcerpt).

    @guarantee OnlyContentSelections
        -- Selecciones que tocan chrome del skin, el propio popup, campos
        -- editables o cruzan fuera del cuerpo de contenido no muestran
        -- la afordancia.

    @guarantee HiddenFromIneligible
        -- Anónimos, cuentas temporales, bloqueados (sitewide o sobre esta
        -- página), usuarios sin config.annotate_right y quienes desactivaron
        -- con§tel en sus preferencias no ven la afordancia. Una página
        -- protegida sí la muestra (AnnotatingIsNotEditing).

    @guarantee KeyboardOperable
        -- Afordancia alcanzable por teclado, nombre accesible ("con§tel");
        -- Enter confirma (salvo con el autocomplete abierto); Escape
        -- descarta sin crear nada.

    @guarantee StaleViewReported
        -- Si la página cambió desde que se cargó, crear informa el
        -- cambio y no crea el §; el rótulo escrito no se pierde.
}

-- La lectura sobre una página: §§ resaltados sobre el texto.
surface PageReading {
    facing viewer: User
    context page: WikiPage where is_annotatable

    let drawn = page_excerpts(page) where is_drawn_on_page

    exposes:
        for e in drawn:
            e.anchor
            e.author
            e.concepts
            e.gloss
            e.author = viewer

    provides:
        ReaderCodesExcerpt(viewer, excerpt, concept_label, variant_confirmed)
            when config.annotate_right in viewer.rights
        ReaderGlossesExcerpt(viewer, excerpt, gloss)
            when config.annotate_right in viewer.rights
        ReaderUncodesExcerpt(viewer, coding)
            when config.annotate_right in viewer.rights
        ReaderDeletesExcerpt(viewer, excerpt)

    related:
        ConceptDetail(concept)

    @guarantee ScopeToggle
        -- Por defecto se resaltan sólo los §§ del viewer (alcance
        -- mine); un control muestra también los de todos (everyone),
        -- distinguiendo propios de ajenos.

    @guarantee DisabledByPreference
        -- con§tel viene DESACTIVADO por defecto (decisión 2026-09-22): cada
        -- lector lo activa en su pestaña de preferencias "con§tel". Mientras
        -- esté desactivado (constel_enabled = false), la página se ve como
        -- sin la extensión:
        -- ni marcas, ni afordancia "§", ni controles de lectura, y el menú de
        -- usuario no menciona con§tel (decisión 2026-09-22). El mapa y la
        -- lista propia siguen existiendo (se llega por Páginas especiales o
        -- su URL). Se reactiva desde las preferencias.

    @guarantee ReadingControlsReachable
        -- Los controles de lectura (alcance mine/everyone, ocultar marcas)
        -- y los accesos al mapa y a la lista propia se ofrecen en el menú
        -- de usuario del skin, alcanzable desde cualquier punto de una
        -- página larga (decisión 2026-09-22). La lectura es un solo control
        -- de tres posiciones, como en con§tel: − (sin marcas) · § (mías) ·
        -- §* (de todos).

    @guarantee NothingForAnonymous
        -- Anónimos y cuentas temporales no ven marcas ni controles de
        -- con§tel sobre las páginas: su acceso es sólo el mapa (ver
        -- ConceptMap.ReadOnlyForAnonymous).

    @guarantee MarksToggle
        -- Un control (el "ojo" de constel) oculta/muestra todas las
        -- marcas para una lectura limpia, sin alterar el scope elegido.

    @guarantee OwnOperationsOnly
        -- Codificar, descodificar y borrar se ofrecen sólo sobre §§
        -- propios (borrar, además, a moderadores).

    @guarantee LostNotDrawn
        -- Los §§ perdidos no se dibujan (no hay dónde); viven en
        -- ConceptDetail, MyReading y el mapa.

    @guarantee CurrentRevisionOnly
        -- La lectura se ofrece sólo sobre la vista de la revisión vigente:
        -- en una revisión antigua, un diff o una acción que no sea «ver», la
        -- página se muestra sin marcas ni afordancia, porque los §§ se
        -- anclan a la vigente (decisión 2026-09-23).
}

-- Detalle de un concepto (panel de constel: "§ en este texto" / "en otros").
surface ConceptDetail {
    facing viewer: User
    context concept: Concept

    exposes:
        concept.label
        for e in concept.excerpts
            where not e.is_frozen or e.author = viewer or "deletedtext" in viewer.rights:
            e.anchor.exact
            e.gloss
            e.page
            e.author
            e.anchor_status
        for m in concept.memberships:
            m.theme.label
            m.owner

    provides:
        ModeratorRenamesConcept(viewer, concept, new_label)
            when config.moderate_right in viewer.rights
        ModeratorMergesConcepts(viewer, concept, absorbed)
            when config.moderate_right in viewer.rights
        ReaderGroupsConcept(viewer, concept, theme)
            when viewer.identity = registered and config.annotate_right in viewer.rights

    related:
        ConceptMap(viewer)

    @guarantee SectionProvenance
        -- El concepto se titula sin «§» (el § es de la sección, no del
        -- concepto). Cada § lleva al pie, en texto pequeño, su página de
        -- procedencia enlazada; no se agrupan bajo el título de la página.

    @guarantee GlossBesideItsSection
        -- La nota (glosa) de un § se muestra junto a él, pegada a su cita,
        -- más sangrada que ella y en letra menor: se lee como comentario de
        -- ESA sección (decisión 2026-09-23). Igual en el detalle sobre la
        -- página y en MyReading. En la interfaz se nombra «Nota (o glosa)».

    @guarantee ModerationInPlace
        -- Quien modera renombra el concepto seleccionado en su propio
        -- título del panel, que se edita en su lugar como el de un tema
        -- (Intro o salir guarda, Esc cancela). Fusionar se ofrece bajo el
        -- mapa, en una sola línea y sin encabezado, nombrando el concepto
        -- seleccionado: «Fusionar «X» con [campo] [Fusionar]». El campo
        -- autocompleta y sólo acepta conceptos existentes (no el mismo): el
        -- botón se habilita con uno elegido o escrito tal cual se llama
        -- (identidad estricta). Confirmar es un diálogo modal al centro de
        -- la pantalla: «Vamos a fusionar «X» en «Y». ¿Lo confirmas?», con
        -- la consecuencia debajo; Esc o un clic fuera cancelan (decisión
        -- 2026-09-26).

    @guarantee OwnFirst
        -- Los §§ del viewer van primero. Los perdidos y los congelados
        -- (éstos, sólo para quien puede verlos: FrozenIsPrivate) se marcan
        -- como tales. No hay «página actual»: el panel vive en el mapa, y
        -- la procedencia de cada § va a su pie (SectionProvenance;
        -- reemplaza HereAndElsewhere, decisión 2026-09-23).
}

-- Especial:Constelación — el mapa de conceptos.
surface ConceptMap {
    facing viewer: User
    context concept: Concept

    exposes:
        concept.label
        concept.excerpts.count
        concept.pages.count
        viewer in concept.readers
        concept_links(concept)

    related:
        ConceptDetail(concept)
        ThemesPanel(viewer)

    @guarantee LabelsNeverOverlapIn2D
        -- En la vista 2D ningún rótulo pisa a otro: cada uno ocupa una caja
        -- ajustada a su texto con un margen breve e igual por los cuatro
        -- lados, y las cajas chocan en vez de traslaparse.

    @guarantee ArrangeByHandIn2D
        -- En la vista 2D quien mira puede mover cada concepto (arrastrándolo,
        -- o con Alt+flechas cuando tiene el foco) y el layout reacciona en
        -- vivo: sus aristas tiran de los vecinos con la fuerza de su grado y
        -- los rótulos chocan y se empujan. Queda fijado donde se suelta; al
        -- enfriarse nada se traslapa y el layout lo respeta al recalcularse
        -- (fuerzas, filtros, ida y vuelta a 3D),
        -- hasta que se pide volver al orden automático. Un clic sin
        -- arrastrar sigue eligiendo el concepto. Es sólo presentación: no
        -- se guarda ni cambia nada del vocabulario.

    @guarantee ReadOnlyForAnonymous
        -- Anónimos y cuentas temporales ven el mapa (alcance everyone) y
        -- navegan a conceptos, temas y páginas, pero no pueden operar
        -- nada: ninguna acción de provides les está disponible.

    @guarantee ReaderAndPageFilters
        -- El mapa se filtra por lectores ("Secciones de") y por páginas,
        -- cada filtro con uno o varios valores. Páginas vacío = TODAS.
        -- Lectores: por defecto el viewer (como la lente); un interruptor
        -- fuera del filtro lo desactiva y entonces son TODOS (decisión
        -- 2026-09-22; reemplaza el alcance mine/everyone). Para un visitante
        -- anónimo el interruptor parte apagado.
        -- Los lectores se nombran por su nombre real (preferencia del
        -- usuario) con el nombre de usuario como respaldo; si el sitio oculta
        -- el nombre real, sólo el de usuario. Sólo se listan lectores de
        -- con§tel, y nunca usuarios ocultos a quien no puede verlos.
        -- Distingue visualmente los conceptos a los que el viewer aportó.

    @guarantee TopologyCoExcerptOverlapAndPage
        -- Dos conceptos se unen (arista con clase y peso) si:
        --   co_excerpt: están codificados en el MISMO §; peso = nº de §§
        --     compartidos (doctrina constel: decisiones del lector).
        --   overlap: codifican §§ ANCLADOS de lectores DISTINTOS sobre la
        --     misma página cuyos rangos comparten al menos un carácter;
        --     peso = nº de pares.
        --   co_page: fueron anotados en la MISMA página (por cualquier
        --     lector, en cualquier §); peso = nº de páginas compartidas
        --     (decisión 2026-09-22: un mapa de §§ de un solo concepto
        --     también debe mostrar su constelación).
        -- Los §§ perdidos aportan co_excerpt y co_page, pero no overlap (no
        -- tienen posición vigente); los congelados no aportan nada
        -- (FrozenIsPrivate). Las tres clases de arista se
        -- distinguen visualmente sólo por su transparencia (siempre
        -- continuas, nunca punteadas); co_page es la más tenue, porque no
        -- es una decisión explícita del lector.

    @guarantee ProximityDegreesAreParametric
        -- Cada grado de proximidad (co_excerpt: misma sección; overlap:
        -- traslape; co_page: mismo texto) tiene su propia fuerza, de 0 a
        -- 100 %, que quien mira ajusta: con qué intensidad atrae a sus
        -- conceptos en el layout y cuán visible es su arista. En 0 el grado
        -- no dibuja arista ni atrae. Se recuerda por navegador. El efecto se
        -- ve también en 2D: allí la escala del layout se mide en rótulos, no
        -- se normaliza por el concepto más lejano.

    @guarantee OverlapNeverConverges
        -- Que dos §§ solapados tengan conceptos distintos es criterio de
        -- sus anotadores (decisión 2026-09-22): el solapamiento NUNCA
        -- identifica, fusiona ni sugiere fusionar esos conceptos, ni
        -- altera la codificación de nadie.

    @guarantee FrequencyScaling
        -- El tamaño del rótulo refleja frecuencia: nº de §§ y nº de
        -- páginas (constel: 0.6·excerpts + 0.4·sources, normalizados).

    @guarantee EdgesToggle
        -- Las aristas pueden ocultarse. No hay un peso mínimo global: el
        -- peso no es comparable entre grados (§§, pares traslapados,
        -- páginas), así que cuánto se ve de cada grado lo decide su fuerza
        -- (ProximityDegreesAreParametric); el peso sólo modula el resorte
        -- y el grosor de su arista.

    @guarantee ThemeLens
        -- Los conceptos se agrupan/colorean por los temas de uno o varios
        -- lectores (la lente). Por defecto, los del viewer; puede sumar
        -- otros lectores y quitarlos, pero para una cuenta registrada la
        -- lente nunca queda vacía. Sólo los temas propios son editables.

    @guarantee AccessibleAlternative
        -- El grafo (2D o 3D) tiene una alternativa textual navegable con
        -- la misma información (conceptos, frecuencias, aristas, temas).
}

-- Panel de temas: síntesis del lector (tab "Mapa" de constel, derecha).
surface ThemesPanel {
    facing viewer: User
    context theme: Theme

    exposes:
        theme.label
        theme.owner
        theme.concepts
        theme.development.text
        theme.development.updated_at
        for c in theme.concepts:
            c.excerpts

    provides:
        ReaderCreatesTheme(viewer, label)
            when viewer.identity = registered and config.annotate_right in viewer.rights
        ReaderRenamesTheme(viewer, theme, label)
            when theme.owner = viewer and config.annotate_right in viewer.rights
        ReaderDeletesTheme(viewer, theme)
            when theme.owner = viewer
        ReaderUngroupsConcept(viewer, membership)
            when theme.owner = viewer and config.annotate_right in viewer.rights
        ReaderWritesThemeDevelopment(viewer, theme, text)
            when theme.owner = viewer and config.annotate_right in viewer.rights

    @guarantee OthersReadOnly
        -- Los temas y desarrollos de otros lectores se pueden leer, nunca
        -- editar.

    @guarantee ThemeSections
        -- Cada tema lista los §§ agrupados (cita, concepto, página) de
        -- todos los lectores cuyos conceptos contiene.
}

-- Especial:MiConstel — la lectura propia, incluidos los §§ perdidos.
surface MyReading {
    facing viewer: User
    context excerpt: Excerpt where author = viewer

    exposes:
        excerpt.anchor.exact
        excerpt.gloss
        excerpt.page
        excerpt.concepts
        excerpt.anchor_status
        excerpt.created_at

    provides:
        ReaderCodesExcerpt(viewer, excerpt, concept_label, variant_confirmed)
            when not excerpt.is_frozen and config.annotate_right in viewer.rights
        ReaderGlossesExcerpt(viewer, excerpt, gloss)
            when not excerpt.is_frozen and config.annotate_right in viewer.rights
        ReaderDeletesExcerpt(viewer, excerpt)
        ReaderExportsReading(viewer)

    related:
        ConceptMap(viewer)

    @guarantee LostFlagged
        -- Los §§ perdidos se listan marcados, con su pasaje citado y la
        -- revisión donde fueron válidos (enlace a ese oldid).

    @guarantee Browsable
        -- La lista no tiene tope oculto: va paginada (cantidad por página
        -- a elección), se ordena por fecha o por estado y se filtra por
        -- página, por concepto y por estado, combinables; los filtros
        -- quedan en la URL y sugieren páginas y conceptos al escribir
        -- (decisión 2026-09-23).

    @guarantee FrozenFlagged
        -- Un § congelado se lista con un aviso de alarma («Texto borrado
        -- por un administrador»), el motivo del borrado y el título de la
        -- página si el registro de borrados deja verlos a quien mira, y
        -- una sola acción: borrar la sección (decisión 2026-09-23).
}

-- Eventos del ciclo de vida de páginas que MediaWiki core entrega a la
-- extensión (hooks PageSaveComplete / PageDeleteComplete /
-- PageUndeleteComplete).
surface PageLifecycle {
    facing page: WikiPage

    provides:
        PageRevised(page, page.latest_revision)
        PageDeleted(page)
        PageRestored(page, page.latest_revision)
}

surface MediaWikiIntegration {
    exposes:
        config.extension_version

    contracts:
        fulfils MediaWikiExtensionConformance
}

------------------------------------------------------------
-- Deferred
------------------------------------------------------------

deferred Concept.has_variants       -- see: docs/ARCHITECTURE.md#conceptos — ¿hay conceptos de otro rótulo con la misma clave tolerante (fold: sin tildes, diéresis ni la marca de la ñ, en minúsculas)?
deferred Concept.normalize_concept    -- see: docs/ARCHITECTURE.md#conceptos — forma canónica de título MW: NFC, trim, '_' y espacios colapsados a uno, primera letra según $wgCapitalLinks; el resto exacto
deferred Excerpt.anchor_resolves      -- see: docs/ARCHITECTURE.md#anclaje — ¿el TextAnchor se ubica sin ambigüedad en el texto renderizado?
deferred Excerpt.relocate             -- see: docs/ARCHITECTURE.md#anclaje — el TextAnchor recalculado en la nueva revisión
deferred Concept.concept_links        -- see: docs/ARCHITECTURE.md#mapa — aristas co_excerpt + overlap + co_page (ver TopologyCoExcerptOverlapAndPage)

------------------------------------------------------------
-- Open questions
------------------------------------------------------------

-- (Sin preguntas abiertas. La del solapamiento se cerró el 2026-09-23: la
-- arista overlap se mantiene como mera relación en el mapa, con su propia
-- fuerza de 0 a 100 % —ProximityDegreesAreParametric—, y nunca identifica
-- ni fusiona conceptos —OverlapNeverConverges—.)
