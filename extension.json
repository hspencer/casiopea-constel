	"config": {
		"ConstelConceptMaxLength": {
			"value": 80,
			"description": "Largo máximo (caracteres) del rótulo de un concepto."
		},
		"ConstelThemeLabelMaxLength": {
			"value": 80,
			"description": "Largo máximo (caracteres) del rótulo de un tema."
		},
		"ConstelNoteMaxLength": {
			"value": 20000,
			"description": "Largo máximo (caracteres) de una nota de desarrollo de un tema."
		},
		"ConstelGlossMaxLength": {
			"value": 5000,
			"description": "Largo máximo (caracteres) de la glosa de un §."
		},
		"ConstelSelectionMinLength": {
			"value": 3,
			"description": "Largo mínimo (caracteres, sin espacios extremos) de un pasaje seleccionado."
		},
		"ConstelSelectionMaxLength": {
			"value": 2000,
			"description": "Largo máximo (caracteres) de un pasaje seleccionado."
		},
		"ConstelAnchorContextLength": {
			"value": 32,
			"description": "Caracteres de contexto (prefix/suffix) que se guardan a cada lado del pasaje para reanclarlo."
		}
	},
	"manifest_version": 2
