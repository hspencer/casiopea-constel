{
	"name": "Casiopea-Con§tel",
	"version": "0.10.0",
	"author": [
		"[https://herbertspencer.net Herbert Spencer González]",
		".:TIG:. Taller de Investigaciones Gráficas, e[ad] Escuela de Arquitectura y Diseño, Pontificia Universidad Católica de Valparaíso"
	],
	"url": "https://github.com/hspencer/casiopea-constel",
	"descriptionmsg": "casiopea-constel-desc",
	"license-name": "Artistic-2.0",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\CasiopeaConstel\\": "src/"
	},
	"TestAutoloadNamespaces": {
		"MediaWiki\\Extension\\CasiopeaConstel\\Tests\\Integration\\": "tests/phpunit/integration/",
		"MediaWiki\\Extension\\CasiopeaConstel\\Tests\\Unit\\": "tests/phpunit/unit/"
	},
	"MessagesDirs": {
		"casiopea-constel": [
			"i18n",
			"i18n/api"
		]
	},
	"ExtensionMessagesFiles": {
		"CasiopeaConstelAlias": "casiopea-constel.alias.php"
	},
	"ServiceWiringFiles": [
		"src/ServiceWiring.php"
	],
	"Hooks": {
		"LoadExtensionSchemaUpdates": "schema",
		"BeforePageDisplay": "page",
		"GetPreferences": "page",
		"PageSaveComplete": "revision",
		"PageDeleteComplete": "revision",
		"PageUndeleteComplete": "revision",
		"SkinTemplateNavigation::Universal": "page"
	},
	"HookHandlers": {
		"schema": {
			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Hooks\\SchemaHooks"
		},
		"page": {
			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Hooks\\PageHooks",
			"services": [
				"NamespaceInfo",
				"PermissionManager",
				"UserOptionsLookup"
			]
		},
		"revision": {
			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Hooks\\RevisionHooks",
			"services": [
				"CasiopeaConstel.ExcerptStore",
				"JobQueueGroup"
			]
		}
	},
	"JobClasses": {
		"constelReanchor": {
			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Jobs\\ReanchorJob",
			"needsPage": true,
			"services": [
				"CasiopeaConstel.ExcerptStore",
				"PageStore",
				"RevisionLookup",
				"CasiopeaConstel.RenderedTextProvider",
				"CasiopeaConstel.AnchorLocator"
			]
		}
	},
	"APIModules": {
		"constel-createexcerpt": {
			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Api\\ApiCreateExcerpt",
			"services": [
				"ActorNormalization",
				"ConnectionProvider",
				"CasiopeaConstel.ConceptStore",
				"CasiopeaConstel.ExcerptStore",
				"CasiopeaConstel.ConceptNormalizer",
				"RevisionLookup",
				"NamespaceInfo",
				"CasiopeaConstel.RenderedTextProvider",
				"CasiopeaConstel.AnchorLocator"
			]
		},
		"constel-codeexcerpt": {
			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Api\\ApiCodeExcerpt",
			"services": [
				"ActorNormalization",
				"ConnectionProvider",
				"CasiopeaConstel.ConceptStore",
				"CasiopeaConstel.ExcerptStore",
				"CasiopeaConstel.ConceptNormalizer"
			]
		},
		"constel-uncodeexcerpt": {
			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Api\\ApiUncodeExcerpt",
			"services": [
				"ActorNormalization",
				"ConnectionProvider",
				"CasiopeaConstel.ConceptStore",
				"CasiopeaConstel.ExcerptStore",
				"CasiopeaConstel.ConceptNormalizer"
			]
		},
		"constel-deleteexcerpt": {
			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Api\\ApiDeleteExcerpt",
