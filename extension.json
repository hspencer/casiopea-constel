			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Api\\ApiQueryConstelReaders",
			"services": [
				"CasiopeaConstel.ReaderDirectory"
			]
		}
	},
	"SpecialPages": {
		"Constellation": {
			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Specials\\SpecialConstellation",
			"services": [
				"CasiopeaConstel.GraphBuilder",
				"ActorNormalization",
				"ConnectionProvider"
			]
		},
		"ConstellationSvg": {
			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Specials\\SpecialConstellationSvg"
		},
		"MyConstel": {
			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Specials\\SpecialMyConstel",
			"services": [
				"CasiopeaConstel.ExcerptStore",
				"CasiopeaConstel.ConceptStore",
				"PageStore",
				"CasiopeaConstel.ExportBuilder",
				"ActorNormalization",
				"ConnectionProvider",
				"CommentStore"
			]
		}
	},
	"AvailableRights": [
		"constel-annotate",
		"constel-moderate"
	],
	"GroupPermissions": {
		"user": {
			"constel-annotate": true
		},
		"sysop": {
			"constel-moderate": true
		}
	},
	"GrantPermissions": {
		"constel": {
			"constel-annotate": true
		}
	},
	"GrantPermissionGroups": {
		"constel": "editpage"
	},
	"LogTypes": [
		"constel"
	],
	"LogNames": {
		"constel": "log-name-constel"
	},
	"LogHeaders": {
		"constel": "log-description-constel"
	},
	"LogActionsHandlers": {
		"constel/*": "LogFormatter"
	},
	"DefaultUserOptions": {
		"constel-enabled": 0,
		"constel-public-ack": 0
	},
	"DatabaseVirtualDomains": [
		"virtual-constel"
	],
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "casiopea-constel/resources"
	},
