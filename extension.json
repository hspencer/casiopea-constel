			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Api\\ApiModerateConcept",
			"services": [
				"ActorNormalization",
				"ConnectionProvider",
				"CasiopeaConstel.ConceptStore",
				"CasiopeaConstel.ConceptNormalizer",
				"CasiopeaConstel.ModerationLog"
			]
		},
		"constel-glossexcerpt": {
			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Api\\ApiGlossExcerpt",
			"services": [
				"ActorNormalization",
				"ConnectionProvider",
				"CasiopeaConstel.ConceptStore",
				"CasiopeaConstel.ExcerptStore",
				"CasiopeaConstel.ConceptNormalizer"
			]
		}
	},
	"APIListModules": {
		"constelexcerpts": {
			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Api\\ApiQueryConstelExcerpts",
			"services": [
				"CasiopeaConstel.ExcerptStore",
				"CasiopeaConstel.ConceptStore",
				"ActorStore",
				"UserFactory",
				"ConnectionProvider",
				"PageStore",
				"TitleFormatter"
			]
		},
		"constelconcepts": {
			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Api\\ApiQueryConstelConcepts",
			"services": [
				"CasiopeaConstel.ConceptStore",
				"CasiopeaConstel.ThemeStore",
				"ActorStore",
				"UserFactory",
				"ConnectionProvider"
			]
		},
		"constelthemes": {
			"class": "MediaWiki\\Extension\\CasiopeaConstel\\Api\\ApiQueryConstelThemes",
